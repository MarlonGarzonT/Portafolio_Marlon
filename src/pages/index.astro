---
// Raíz: redirige al idioma del navegador (inglés si lo prefiere; español por defecto). Sin JS, /es/.
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Marlon Garzón</title>
    <meta name="robots" content="noindex" />
    <script is:inline>
      (function () {
        var langs = navigator.languages || [navigator.language || ''];
        var target = '/es/';
        for (var i = 0; i < langs.length; i++) {
          var l = String(langs[i]).toLowerCase();
          if (l.indexOf('es') === 0) break;
          if (l.indexOf('en') === 0) { target = '/en/'; break; }
        }
        location.replace(target + location.hash);
      })();
    </script>
    <meta http-equiv="refresh" content="0; url=/es/" />
  </head>
  <body style="font-family: -apple-system, system-ui, sans-serif">
    <p><a href="/es/">Español</a> · <a href="/en/">English</a></p>
  </body>
</html>
