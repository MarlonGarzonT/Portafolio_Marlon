---
import '../styles/global.css';
import { htmlLang, ogLocale, locales, defaultLocale, type Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
  title: string;
  description: string;
  /** Ruta sin prefijo de idioma, p. ej. "/". */
  path?: string;
  noindex?: boolean;
}

const { locale, title, description, path = '/', noindex = false } = Astro.props;
const site = Astro.site ?? new URL(Astro.url.origin);
const urlFor = (l: Locale) => new URL(`/${l}${path}`, site).href;
const canonical = urlFor(locale);
---

<!doctype html>
<html lang={htmlLang[locale]} class="k-ios">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    {
      !noindex && (
        <>
          <link rel="canonical" href={canonical} />
          {locales.map((l) => <link rel="alternate" hreflang={htmlLang[l]} href={urlFor(l)} />)}
          <link rel="alternate" hreflang="x-default" href={urlFor(defaultLocale)} />
        </>
      )
    }
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={ogLocale[locale]} />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#efeff4" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#000000" media="(prefers-color-scheme: dark)" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- Aplica el tema antes de pintar (sin destello). Misma lógica que src/lib/theme.ts. -->
    <script is:inline>
      (function () {
        var pref = 'system';
        try {
          pref = localStorage.getItem('theme') || 'system';
        } catch (e) {}
        var mq = window.matchMedia('(prefers-color-scheme: dark)');
        function paint() {
          var p = 'system';
          try {
            p = localStorage.getItem('theme') || 'system';
          } catch (e) {}
          var dark = p === 'dark' || (p === 'system' && mq.matches);
          document.documentElement.classList.toggle('dark', dark);
          document.documentElement.style.colorScheme = dark ? 'dark' : 'light';
        }
        paint();
        // En "Automática", sigue los cambios del sistema en vivo.
        mq.addEventListener('change', paint);
      })();
    </script>
  </head>
  <body id="top" class="bg-ios-light-surface font-ios text-black antialiased dark:bg-ios-dark-surface dark:text-white">
    <slot />
  </body>
</html>
