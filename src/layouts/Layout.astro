---
import '../styles/global.css';
import { htmlLang, ogLocale, locales, defaultLocale, type Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
  title: string;
  description: string;
  /** Ruta sin prefijo de idioma, p. ej. "/". */
  path?: string;
  noindex?: boolean;
}

const { locale, title, description, path = '/', noindex = false } = Astro.props;
const site = Astro.site ?? new URL(Astro.url.origin);
const urlFor = (l: Locale) => new URL(`/${l}${path}`, site).href;
const canonical = urlFor(locale);
---

<!doctype html>
<!-- Solo modo oscuro: `dark` fijo (variantes dark: de Tailwind y Konsta) y esquema de color oscuro
     para los controles nativos y las barras de desplazamiento. -->
<html lang={htmlLang[locale]} class="k-ios dark" style="color-scheme: dark">

  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    {
      !noindex && (
        <>
          <link rel="canonical" href={canonical} />
          {locales.map((l) => <link rel="alternate" hreflang={htmlLang[l]} href={urlFor(l)} />)}
          <link rel="alternate" hreflang="x-default" href={urlFor(defaultLocale)} />
        </>
      )
    }
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={ogLocale[locale]} />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#000000" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
  </head>
  <body id="top" class="bg-ios-dark-surface font-ios text-white antialiased">
    <slot />
  </body>
</html>
